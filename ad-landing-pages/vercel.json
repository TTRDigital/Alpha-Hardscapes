{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/number.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|images/|number\\.js).*)",
      "has": [
        {
          "type": "host",
          "value": "go.alphahardscapes.com"
        }
      ],
      "destination": "/go"
    },
    {
      "source": "/((?!api/|images/|number\\.js).*)",
      "has": [
        {
          "type": "host",
          "value": "paver.alphahardscapes.com"
        }
      ],
      "destination": "/outdoor"
    },
    {
      "source": "/((?!api/|images/|number\\.js).*)",
      "destination": "/outdoor"
    }
  ],
  "redirects": [
    {
      "source": "/retaining-walls",
      "destination": "https://alphahardscapes.com/retaining-walls-connecticut/",
      "permanent": false
    },
    {
      "source": "/retaining-walls/:path*",
      "destination": "https://alphahardscapes.com/retaining-walls-connecticut/",
      "permanent": false
    }
  ]
}
