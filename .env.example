# Copy to .env.local for local development. In Vercel, add these under
# Project Settings > Environment Variables. Never commit real values.

# --- Site
NEXT_PUBLIC_SITE_URL=https://alphahardscapes.com
# Sanity project 7ysj6im9 is built in (sanity/env.ts). Optional other dataset:
# NEXT_PUBLIC_ALPHA_SANITY_DATASET=production
# "local" shows the built-in copy (content/seed.json) instead of the CMS.
# SITE_CONTENT=local

# --- Sanity
# Shared secret for the /api/revalidate webhook (same value in the Sanity webhook)
SANITY_REVALIDATE_SECRET=
# Only for `npm run seed` on your machine (Editor token). Not needed in Vercel.
SANITY_WRITE_TOKEN=

# --- Form submissions (at least one destination)
# GoHighLevel inbound webhook. Already set in lib/lead.ts; only set this to override it.
GHL_WEBHOOK_URL=
# Email notification through Resend (resend.com). LEAD_EMAIL_TO accepts a comma-separated list.
RESEND_API_KEY=
LEAD_EMAIL_TO=alphahardscapes1@gmail.com
LEAD_EMAIL_FROM=
# Google reCAPTCHA v2 secret for the site key already in the forms. Empty = not checked server-side.
RECAPTCHA_SECRET_KEY=

# --- Draft preview for TTR OS's page fixer (lib/preview.ts), same names as the Beverly Hills site. Server-only.
# Shared with TTR OS, which signs /api/preview links with it (HMAC-SHA256 of "<path>\n<exp>").
# SANITY_PREVIEW_SECRET is read if PREVIEW_SECRET is empty. Empty: the preview route refuses.
PREVIEW_SECRET=
# Sanity token with read (Viewer) access to project 7ysj6im9, sent only while draft mode is on.
SANITY_READ_TOKEN=
